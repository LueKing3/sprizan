# SPRIZAN (100% Free Community Edition)
# The entire project operates without any payment, billing accounts, credit cards, or paid subscriptions.

# Free URLhaus Community API (abuse.ch)
# Register for a 100% free account at https://urlhaus.abuse.ch/api/ or https://auth.abuse.ch/
# to obtain your personal Auth-Key. No payment, credit card, or billing setup is ever required.
# If omitted, SPRIZAN operates seamlessly in standalone mode using its enhanced local heuristic engine.
URLHAUS_AUTH_KEY=

# Local Server Port (default: 3000)
PORT=3000
